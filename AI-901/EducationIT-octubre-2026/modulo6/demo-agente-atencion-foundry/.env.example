# Endpoint del proyecto Foundry, con formato:
# https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
# Nombre exacto del deployment del modelo disponible en ese proyecto
FOUNDRY_MODEL=

# Requerido solo si vas a subir audio; el texto pegado no necesita Speech.
SPEECH_KEY=
SPEECH_REGION=

FLASK_SECRET_KEY=demo-local
