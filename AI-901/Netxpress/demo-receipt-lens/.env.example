# Copia este archivo como .env y coloca los valores de Azure.
# Endpoint: rsv-vision > Overview > Endpoint
VISION_ENDPOINT=https://rsv-vision.cognitiveservices.azure.com
# Pega localmente una clave de Keys and Endpoint. No la publiques ni la compartas.
VISION_KEY=REEMPLAZAR_CON_TU_CLAVE
VISION_API_VERSION=2024-02-01
PORT=5000
